# Variáveis de DESENVOLVIMENTO local (cp .env.example .env). Produção: variáveis criptografadas do Coolify — modelo em infra/.env.example.
# Nunca versione valores reais.

# ---------- Web (Next.js) — apps/web ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # npx supabase status -o env  →  ANON_KEY
# A Central (assistente da equipe) também lê CENTRALOPS_OPENROUTER_KEY e CENTRALOPS_GROQ_KEY abaixo, no servidor (nunca NEXT_PUBLIC_).

# ---------- Worker (Python) — apps/worker: lê estas variáveis (prefixo CENTRALOPS_) ----------
CENTRALOPS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
CENTRALOPS_SUPABASE_URL=http://127.0.0.1:55321
CENTRALOPS_SUPABASE_SERVICE_KEY=                # npx supabase status -o env  →  SERVICE_ROLE_KEY (só no worker, nunca no browser)
CENTRALOPS_AGENT_CTX_SECRET=dev-only-change-me-with-at-least-32-bytes   # assina o token de contexto do agente (worker e MCP precisam ter o MESMO)
CENTRALOPS_OPENROUTER_KEY=                      # worker e web. Sem chave: conversas em modo IA caem para humano e a Central funciona em modo busca
CENTRALOPS_HERMES_BASE=http://127.0.0.1:8642/v1
CENTRALOPS_HERMES_KEY=                          # vazio = não usa o Hermes
# Hermes exclusivo do CentralOps (LLM = AGY), escolhido como modelo `hermes/agy` em Modelos & custos (web e worker). Ver infra/hermes/central/
CENTRALOPS_HERMES_LLM_BASE=http://centralops-hermes:8642/v1
CENTRALOPS_HERMES_LLM_KEY=                      # API_SERVER_KEY de ~/centralops-hermes/data/.env; vazio = rotas hermes/* caem nas reservas do OpenRouter
CENTRALOPS_FOCUS_API_BASE=https://homologacao.focusnfe.com.br
CENTRALOPS_FOCUS_TOKEN=
CENTRALOPS_GROQ_KEY=                            # transcrição de áudio (opcional): WhatsApp no worker e microfone da Central na web
CENTRALOPS_LOG_LEVEL=INFO

# ---------- Servidor MCP — apps/agent/mcp_server ----------
CENTRALOPS_AGENT_DATABASE_URL=postgresql://agent_rpc:agent_rpc@127.0.0.1:55322/postgres   # role sem acesso a tabelas
CENTRALOPS_MCP_KEY=dev-only-mcp-key-change-me   # Bearer que o Hermes envia ao MCP

# ---------- Edge Functions de webhook: copie supabase/functions/.env.example para supabase/functions/.env.local ----------
# META_VERIFY_TOKEN, META_APP_SECRETS, TELEGRAM_WEBHOOK_SECRET

# ---------- Observabilidade (opcional) ----------
SENTRY_DSN=
