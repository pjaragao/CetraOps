# Variáveis da stack de produção (infra/docker-compose.prod.yml). Em produção ficam como variáveis CRIPTOGRAFADAS do Coolify —
# este arquivo é só o modelo; nunca versione valores reais.

# ---- Imagens e domínio ----
CENTRALOPS_IMAGE_OWNER=pjaragao                 # dono no GHCR (minúsculas): ghcr.io/<dono>/centralops-web
CENTRALOPS_TAG=prod                             # a tag `prod` é reapontada pelo workflow Release (aprovação manual) e pelo Rollback
CENTRALOPS_DOMAIN=app.exemplo.com.br
EDGE_NETWORK=coolify                     # rede do Traefik do Coolify
HERMES_IMAGE=nousresearch/hermes-agent@sha256:<digest>

# ---- Supabase (sa-east-1) ----
CENTRALOPS_SUPABASE_URL=https://<projeto>.supabase.co
CENTRALOPS_SUPABASE_SERVICE_KEY=                # service role: só no worker, nunca no browser
CENTRALOPS_DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres   # pooler em modo SESSÃO (LISTEN/transações longas)
CENTRALOPS_AGENT_DATABASE_URL=postgresql://agent_rpc.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres   # role agent_rpc (troque a senha padrão da migration!)

# ---- Segredos internos (gere com: openssl rand -hex 32) ----
CENTRALOPS_AGENT_CTX_SECRET=                    # assina o token de contexto do agente (worker e MCP precisam ter o MESMO)
CENTRALOPS_MCP_KEY=                             # Hermes → MCP
CENTRALOPS_HERMES_KEY=                          # worker → Hermes (API_SERVER_KEY)

# ---- IA ----
CENTRALOPS_OPENROUTER_KEY=                      # ative ZDR e data_collection=deny na conta (LGPD)
CENTRALOPS_GROQ_KEY=                            # transcrição de áudio (Whisper)

# ---- Fiscal ----
CENTRALOPS_FOCUS_API_BASE=https://api.focusnfe.com.br    # homologação: https://homologacao.focusnfe.com.br
CENTRALOPS_FOCUS_TOKEN=

CENTRALOPS_LOG_LEVEL=INFO

# ---- Somente no GitHub (Actions › Variables) para o build da imagem web ----
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY   (a chave anon é pública por desenho)
