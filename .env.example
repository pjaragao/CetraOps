# ==========================================
# CetraOps / SIÉ Joy OS - Variáveis de Ambiente
# ==========================================

# Configuração do Servidor
PORT=3001
HOST=0.0.0.0

# Supabase - Conexão e Autenticação
# Obtenha estas credenciais no painel do Supabase: Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# Sincronização Automática com Supabase (true/false)
SUPABASE_AUTO_SYNC=false
